# Copia este archivo a .env.local (desarrollo) o pon estas variables en Vercel.

# Desarrollo: la API directa. Producción: "/api", y la web reenvía las
# peticiones a API_PROXY_TARGET (así la cookie de sesión es del mismo sitio).
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Solo producción: dirección pública de la API, sin /api al final.
# API_PROXY_TARGET="https://tu-api.up.railway.app"

# El mismo ID de cliente OAuth que GOOGLE_CLIENT_ID en la API.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
