DATABASE_URL="postgresql://postgres:TU_CONTRASEÑA@localhost:5432/russian_course"
# Aleatorio y de al menos 32 caracteres; la API no arranca con el de ejemplo.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="1d"
PORT=4000
CORS_ORIGIN="http://localhost:3000,http://localhost:3001"
# Número de proxies delante de la API (nginx, Render…). Vacío si no hay ninguno.
# Si el frontend reenvía /api a la API (API_PROXY_TARGET en Vercel) suma uno más.
TRUST_PROXY=""
# La sesión va en una cookie httpOnly. "lax" sirve si frontend y API comparten
# sitio (localhost, o app.dominio.com y api.dominio.com); con dominios
# distintos usa "none" (exige HTTPS). En producción pon NODE_ENV=production
# para que la cookie solo viaje por HTTPS.
COOKIE_SAMESITE="lax"
# ID de cliente OAuth (tipo "Aplicación web") de Google Cloud; el mismo que usa el frontend.
GOOGLE_CLIENT_ID=""
# URL del frontend; con ella se arma el enlace del correo de confirmación.
APP_URL="http://localhost:3000"
# Correos de Google que son admin, separados por coma. Pasan a admin al entrar
# con el botón de Google (con contraseña no: así nadie lo consigue sin el buzón).
ADMIN_EMAILS=""
# Servidor de correo. Si SMTP_HOST queda vacío no se envía nada y el enlace de
# confirmación aparece en la consola de la API (útil en desarrollo).
# Con Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_USER tu Gmail y
# SMTP_PASS una "contraseña de aplicación" (myaccount.google.com/apppasswords,
# exige verificación en dos pasos), nunca tu contraseña normal. MAIL_FROM debe
# usar ese mismo Gmail. Gmail admite unos 500 envíos al día.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Поехали <tu-correo@gmail.com>"
