generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

// Niveles del Marco Común Europeo (equivalentes a ТЭУ, ТБУ, ТРКИ-1..4)
enum CourseLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

// QUIZ es el test de una estación; EXAM, el examen final del curso.
enum AssessmentType {
  QUIZ
  EXAM
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Vacía en las cuentas que solo entran con Google.
  passwordHash String?
  // Identificador de la cuenta de Google (`sub`), si entró alguna vez con ella.
  googleId     String?  @unique
  // Sin confirmar el correo la cuenta no puede entrar. Google y las altas de
  // un admin la dan por confirmada.
  emailVerifiedAt    DateTime?
  // Último correo de confirmación enviado; limita los reenvíos.
  verificationSentAt DateTime?
  // Versión de las sesiones: sube al cambiar la contraseña y deja sin efecto
  // los tokens emitidos antes.
  tokenVersion       Int       @default(0)
  firstName    String
  lastName     String
  // Nombre completo para mostrar; lo arma el servidor con nombre y apellido.
  name         String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments Enrollment[]

  @@index([role])
  @@index([lastName])
}

// Los cursos son de la plataforma: los crea y edita un admin. No hay profes:
// el estudiante avanza solo y los tests se califican automáticamente.
model Course {
  id          String       @id @default(uuid())
  title       String
  slug        String       @unique
  description String
  level       CourseLevel
  status      CourseStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]
  assessments Assessment[]

  @@index([status, level])
}

model Lesson {
  id              String   @id @default(uuid())
  courseId        String
  title           String
  content         String
  order           Int
  durationMinutes Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  assessments Assessment[]

  @@unique([courseId, order])
}

model Enrollment {
  id          String           @id @default(uuid())
  studentId   String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  student  User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course   Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  progress LessonProgress[]
  attempts Attempt[]

  @@unique([studentId, courseId])
  @@index([courseId, status])
}

model LessonProgress {
  id           String   @id @default(uuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
}

// Test de opción múltiple de un curso. `weight` es el % que aporta a la nota
// final; la suma de los pesos de un curso no puede superar 100.
// `questions` es una lista de { prompt, options, answer, explanation }, donde
// `answer` es el índice de la opción correcta. Con `lessonId` es el test de esa
// estación: aprobarlo la completa y abre la siguiente.
model Assessment {
  id           String         @id @default(uuid())
  courseId     String
  lessonId     String?
  title        String
  type         AssessmentType
  instructions String?
  questions    Json           @default("[]")
  maxScore     Decimal        @db.Decimal(6, 2)
  weight       Decimal        @db.Decimal(5, 2)
  dueDate      DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   Lesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attempts Attempt[]

  @@index([courseId])
}

// Un intento de un estudiante en un test; `answers[i]` es la opción que eligió
// en `questions[i]`. Se califica al enviarlo, se puede repetir sin límite y
// cuenta el mejor. Guarda aciertos y total, no la nota, para que cambiar
// `maxScore` no deje notas desfasadas.
model Attempt {
  id           String   @id @default(uuid())
  assessmentId String
  enrollmentId String
  answers      Int[]
  correct      Int
  total        Int
  createdAt    DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, enrollmentId])
  @@index([enrollmentId])
}
